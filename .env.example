# Base de la API externa de Vertex, sin /v1 al final. En local: http://localhost:4010/api/external
VITE_STOREFRONT_BASE_URL=

# Slug del local (venue) que vende en esta tienda.
VITE_STOREFRONT_VENUE=

# Clave publicable del local: empieza con rst_pk_. Necesita read:catalog, write:carts, write:checkouts y write:shoppers,
# y sus allowed_origins tienen que incluir exactamente el origen de la tienda (http://localhost:5200 en local).
VITE_STOREFRONT_KEY=

# Opcional. off oculta el envío a domicilio y deja solo el retiro en el local: para un Vertex que todavía no tiene
# el envío con Andreani. Sin definir, el envío se ofrece si el local lo tiene conectado.
# VITE_HOME_DELIVERY=off
